<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Only the system CA store is trusted (no user-installed CAs), in every build type. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
