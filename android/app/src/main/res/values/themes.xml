<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Flatmates" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:colorPrimary">@color/navy</item>
    </style>
    <style name="Theme.Flatmates.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Flatmates</item>
    </style>
</resources>
